name: Atualizar sitemap.xml

on:
  push:
    branches: [main]
    # Evita loop: ignora pushes que só alteraram o próprio sitemap.xml
    paths-ignore:
      - 'sitemap.xml'
      - 'produtos/**'
      - 'atelie/**'
  schedule:
    # Sincroniza produtos do Supabase e recria as páginas estáticas a cada 15 minutos.
    - cron: '*/15 * * * *'
  workflow_dispatch: {}

permissions:
  contents: write

jobs:
  atualizar-sitemap:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout do repositório
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Configurar Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Gerar páginas estáticas dos produtos e sitemap.xml
        run: node scripts/generate-product-pages.js

      - name: Commitar sitemap.xml (somente se houver alteração)
        run: |
          if git diff --quiet -- sitemap.xml produtos atelie; then
            echo "Nenhuma alteração no sitemap.xml."
            exit 0
          fi
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add sitemap.xml produtos atelie
          git commit -m "chore: atualizar sitemap.xml automaticamente"
          git push
